# EducaTudo — ambiente local Docker
# Uso: cp backend/.env.docker.example backend/.env
#
# Domínios locais (mesmo padrão de produção, TLD .localhost):
#   Master → http://master.localhost
#   Colag  → http://colag.localhost
#
# *.localhost resolve para 127.0.0.1 na maioria dos browsers (sem /etc/hosts).

APP_ENV=development
APP_DEBUG=true
APP_URL=http://master.localhost

# Performance Profiler (Master → Performance) — só coleta com APP_DEBUG=true acima.
# Todos opcionais, com default sensato; descomente só se quiser ajustar.
# PERF_EXPLAIN_THRESHOLD_MS=50    # query acima disso dispara EXPLAIN ANALYZE automático
# PERF_N1_THRESHOLD=5             # repetições do mesmo SQL pra virar alerta de N+1
# PERF_MAX_EXPLAINS=5             # teto de EXPLAIN ANALYZE reais por request
# PERF_RETENTION_DAYS=7           # apaga requests_*.jsonl mais velhos que N dias (0 = nunca apaga)

# Banco MASTER (multi-tenant)
MULTI_TENANT=true
MASTER_DOMAIN=master.localhost
DB_HOST=mysql
DB_PORT=3306
DB_NAME=educatudo_master
DB_USER=root
DB_PASS=root

# Admin MySQL — cria banco/usuário de escola pelo painel Master
DB_ADMIN_HOST=mysql
DB_ADMIN_PORT=3306
DB_ADMIN_USER=root
DB_ADMIN_PASS=root

# Sessão cross-subdomínio (master.localhost + colag.localhost)
SESSION_DOMAIN=.localhost
SESSION_SECURE=false

# Redis (container Docker — host "redis" na rede interna)
REDIS_HOST=redis
REDIS_PORT=6379

# Cifragem de secrets (dev only — gere outra em produção)
MASTER_ENCRYPTION_KEY=dev-local-educatudo-change-me-in-production

# JWT API Pais / Mobile (obrigatório — mínimo 32 chars; gere com: openssl rand -hex 32)
JWT_SECRET=dev-local-jwt-secret-change-me-32chars-min
JWT_TTL=86400

# Storage local (sem S3)
DRIVE_STORAGE=local
MEDIA_STORAGE=local
MEDIA_TENANT_PREFIX=true

# Métricas no bootstrap (desativado no dev local)
DISABLE_BOOTSTRAP_METRICS=1

# Escola (fallback; multi-tenant usa slug/dominio do tenant)
SCHOOL_CODE=colag
ESCOLA_NOME=Colag
SCHOOL_SECRET_KEY=dev-local-master-auth-secret

# Sessão / CSRF
SESSION_LIFETIME=3600
CSRF_TOKEN_NAME=_token

# APIs externas — deixe vazio no dev local
OPENAI_API_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=

# WebSocket (opcional)
WS_URL=ws://localhost:3001
