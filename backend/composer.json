{
    "name": "educatudo/platform",
    "description": "Plataforma Educacional Single-Tenant com IA",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "EducaTudo Team",
            "email": "dev@educatudo.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "aws/aws-sdk-php": "^3.0",
        "dompdf/dompdf": "^3.1",
        "ezyang/htmlpurifier": "^4.16",
        "google/apiclient": "^2.18",
        "google/cloud-vision": "^2.1",
        "phpmailer/phpmailer": "^6.9",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "files": [
            "app/Compat/models_autoload.php",
            "app/Compat/controllers_autoload.php",
            "app/Compat/services_autoload.php",
            "app/Compat/ai_autoload.php",
            "app/Compat/api_autoload.php",
            "app/Compat/pwa_autoload.php",
            "app/Compat/webhooks_autoload.php",
            "app/Compat/noticias_autoload.php",
            "app/Compat/media_autoload.php",
            "app/Compat/tickets_autoload.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "App\\Infra\\": "app/Infra/",
            "App\\Modulos\\CensoEscolar\\": "app/Modulos/censo-escolar/",
            "App\\Modulos\\ConselhoClasse\\": "app/Modulos/conselho-classe/",
            "App\\Modulos\\Diario\\": "app/Modulos/diario/",
            "App\\Modulos\\Ocorrencias\\": "app/Modulos/ocorrencias/",
            "App\\Modulos\\RegrasAcademicas\\": "app/Modulos/regras-academicas/",
            "App\\Modulos\\DashboardGestao\\": "app/Modulos/dashboard-gestao/",
            "App\\Modulos\\VidaEscolar\\": "app/Modulos/vida-escolar/",
            "App\\Modulos\\Comunicacao\\": "app/Modulos/comunicacao/",
            "App\\Modulos\\Financeiro\\": "app/Modulos/financeiro/",
            "App\\Modulos\\EducaInclui\\": "app/Modulos/educainclui/",
            "App\\Modulos\\Conformidade\\": "app/Modulos/conformidade/",
            "App\\Modulos\\Patrimonio\\": "app/Modulos/patrimonio/",
            "App\\Modulos\\Matricula\\": "app/Modulos/matricula/",
            "App\\Modulos\\Boletins\\": "app/Modulos/boletins/",
            "App\\Modulos\\Mural\\": "app/Modulos/mural/",
            "App\\Modulos\\AulasOnline\\": "app/Modulos/aulas-online/",
            "App\\Modulos\\Minicursos\\": "app/Modulos/minicursos/",
            "App\\Modulos\\Exercicios\\": "app/Modulos/exercicios/",
            "App\\Modulos\\Apostilas\\": "app/Modulos/apostilas/",
            "App\\Modulos\\Ava\\": "app/Modulos/ava/",
            "App\\Modulos\\Redacoes\\": "app/Modulos/redacoes/",
            "App\\Modulos\\Jornadas\\": "app/Modulos/jornadas/",
            "App\\Modulos\\Provas\\": "app/Modulos/provas/",
            "App\\Modulos\\Forum\\": "app/Modulos/forum/",
            "App\\Modulos\\Flashcards\\": "app/Modulos/flashcards/",
            "App\\Modulos\\Notificacoes\\": "app/Modulos/notificacoes/",
            "App\\Modulos\\Fechamento\\": "app/Modulos/fechamento/",
            "App\\Modulos\\ModelosDocumentos\\": "app/Modulos/modelos-documentos/",
            "App\\Modulos\\GruposRegrasNotas\\": "app/Modulos/grupos-regras-notas/",
            "App\\Modulos\\Drive\\": "app/Modulos/drive/",
            "App\\Modulos\\Arquivos\\": "app/Modulos/arquivos/",
            "App\\Modulos\\Presenca\\": "app/Modulos/presenca/",
            "App\\Modulos\\ExpoColag\\": "app/Modulos/expo-colag/",
            "App\\Modulos\\AgrupamentosComponentes\\": "app/Modulos/agrupamentos-componentes/",
            "App\\Modulos\\EducaHits\\": "app/Modulos/educahits/",
            "App\\Modulos\\EducaLabs\\": "app/Modulos/educalabs/",
            "App\\Modulos\\EventosAvaliativos\\": "app/Modulos/eventos-avaliativos/",
            "App\\Modulos\\ExternalApps\\": "app/Modulos/external-apps/",
            "App\\Modulos\\Lex\\": "app/Modulos/lex/",
            "App\\Modulos\\Jogos\\": "app/Modulos/jogos/",
            "App\\Modulos\\Notes\\": "app/Modulos/notes/",
            "App\\Modulos\\Noticias\\": "app/Modulos/noticias/",
            "App\\Modulos\\Tickets\\": "app/Modulos/tickets/",
            "App\\Dominio\\Pessoas\\": "app/Dominio/Pessoas/",
            "App\\Dominio\\Escola\\": "app/Dominio/Escola/",
            "App\\Painel\\": "app/Painel/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000"
    },
    "config": {
        "platform": {
            "php": "8.4.24"
        },
        "platform-check": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
