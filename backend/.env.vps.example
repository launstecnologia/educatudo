# EducaTudo — VPS (MySQL remoto)
# Uso na VPS: cp backend/.env.vps.example backend/.env && nano backend/.env
#
# O script scripts/up-vps.sh copia este arquivo se backend/.env não existir.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://master.educatudo.com

# Performance Profiler (Master → Performance): fica 100% desligado com
# APP_DEBUG=false acima (não é contornável pelo painel). Só ligue temporariamente
# pra diagnosticar algo específico, nunca deixe true em produção por padrão.
# PERF_RETENTION_DAYS=7

MULTI_TENANT=true
MASTER_DOMAIN=master.educatudo.com
TENANT_BASE_DOMAIN=educatudo.com
DOMINIO_WILDCARD_HABILITADO=true
SESSION_DOMAIN=.educatudo.com
SESSION_SECURE=true

# MySQL REMOTO (fora do Docker)
DB_HOST=SEU_HOST_MYSQL
DB_PORT=3306
DB_NAME=educatudo_master
DB_USER=educatudo
DB_PASS=ALTERAR_SENHA

# Admin MySQL — provisionamento de banco tenant pelo Master (mesmo host ou usuário admin)
DB_ADMIN_HOST=SEU_HOST_MYSQL
DB_ADMIN_PORT=3306
DB_ADMIN_USER=root
DB_ADMIN_PASS=ALTERAR_SENHA_ADMIN

# Redis (container local na VPS — requer extensão phpredis na imagem PHP).
# Obrigatório: sem REDIS_HOST o PHP tenta 127.0.0.1 e o cache de tenant não funciona.
# Use o nome do serviço no compose (`redis`), não 127.0.0.1.
REDIS_HOST=redis
REDIS_PORT=6379
# Opcional/recomendado quando Redis estiver em VM separada.
# REDIS_PASSWORD=GERAR_SENHA_FORTE

# Memória do container PHP (lida pelo docker compose na raiz, não por este .env).
# Na VPS 16 GB o default do docker-compose.vps.yml já é 4g.
# Para override: na raiz do repo, crie/edite .env com PHP_MEM_LIMIT=4g
# PHP_MEM_LIMIT=4g

# Obrigatório — gere com: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=GERAR_CHAVE_32_BYTES_HEX

# JWT API Pais / Mobile (obrigatório — mínimo 32 chars; gere com: openssl rand -hex 32)
JWT_SECRET=GERAR_JWT_SECRET_32_BYTES_HEX
JWT_TTL=86400

# SSL wildcard na origem (opcional — exibição de expiração no Master)
SSL_CERT_PATH=/etc/letsencrypt/live/educatudo.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/educatudo.com/privkey.pem

# Cron HTTP verificação de domínios
DOMINIO_VERIFICAR_CRON_KEY=GERAR_CHAVE_CRON

# Storage
DRIVE_STORAGE=local
MEDIA_STORAGE=local
MEDIA_TENANT_PREFIX=true
DISABLE_BOOTSTRAP_METRICS=1

SESSION_LIFETIME=3600
CSRF_TOKEN_NAME=_token

# Preencher conforme integrações ativas
OPENAI_API_KEY=
