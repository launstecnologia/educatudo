# Copie para .env e preencha a senha do admin da homologação.
# Uso: ./run.sh cadastro   depois   ./run.sh acesso

BASE_URL=https://hml-escola.educatudo.com

# Só preencha se o host NÃO for da escola (várias escolas no mesmo domínio).
TENANT_SLUG=

# Admin da escola em hml-escola — obrigatório para criar os alunos
ADMIN_LOGIN=admin@escola.com
ADMIN_SENHA=

# Login do aluno = nickname carga00001, carga00002...
# Senha NÃO pode ser 123456 (o sistema força troca).
PREFIXO_ALUNO=carga
ALUNO_SENHA_PADRAO=Carga@2026
TOTAL_ALUNOS=1000

# Criar: VUs = cadastros em paralelo (10 é seguro; bcrypt pesa no PHP)
# Acessar: VUs = alunos simultâneos (NÃO coloque 5000 — o notebook e a HML caem)
VUS=10
DURATION=40m

# Opcional — prova/jornada depois que os alunos existirem
PROVA_ID=
JORNADA_ID=
