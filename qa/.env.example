# Copie para qa/.env. Nunca commite qa/.env.
# A suíte recusa hosts de produção (*.educatudo.com).

QA_BASE_URL=http://colag.localhost

# Conta de admin da escola no ambiente local ou de homologação.
# Os scripts locais em tmp/smoke_*.php usam a conta de desenvolvimento da Colag.
# Não coloque senha de produção aqui.
QA_ADMIN_EMAIL=
QA_ADMIN_SENHA=

# Opcional. Sem estas variáveis, o teste de permissão do professor é ignorado.
QA_PROFESSOR_EMAIL=
QA_PROFESSOR_SENHA=

# 1 só com autorização explícita para criar registros fictícios prefixados com QA.
# O padrão é somente leitura: POST/PUT/DELETE são interceptados e não gravam.
QA_PERMITIR_GRAVACAO=0

# Fora de localhost / *.localhost, exige este valor. Produção continua bloqueada.
# QA_CONFIRMAR_AMBIENTE=homologacao
